<!DOCTYPE html>
<html>

<head>

    <title>User Profile</title>

</head>


<body>

    <h1>User Profile</h1>


    <!-- ================================= -->
    <!-- PARENT INFORMATION -->
    <!-- ================================= -->

    <h2>
        <%= user.firstName %>
        <%= user.lastName %>
    </h2>

    <p>
        <strong>Email:</strong>
        <%= user.email %>
    </p>

    <p>
        <strong>Phone:</strong>
        <%= user.phone %>
    </p>


    <hr>


    <!-- ================================= -->
    <!-- CHILDREN -->
    <!-- ================================= -->

    <h2>Children</h2>


    <% if (children.length === 0) { %>

        <p>
            No children added yet.
        </p>

    <% } else { %>


        <% children.forEach(child => { %>

            <div>

                <h3>
                    <%= child.firstName %>
                    <%= child.lastName %>
                </h3>


                <p>
                    <strong>Age:</strong>
                    <%= child.age %>
                </p>


                <p>
                    <strong>Email:</strong>
                    <%= child.email || "Not provided" %>
                </p>


                <p>
                    <strong>Child ID:</strong>
                    <%= child._id %>
                </p>


                <!-- DELETE CHILD -->

                <form
                    action="/users/<%= user._id %>/children/<%= child._id %>/delete"
                    method="POST"
                >

                    <button type="submit">
                        Delete Child
                    </button>

                </form>

            </div>

            <hr>

        <% }) %>

    <% } %>


    <!-- ================================= -->
    <!-- ADD CHILD -->
    <!-- ================================= -->

    <p>

        <a href="/users/<%= user._id %>/children/new">

            Add Child

        </a>

    </p>


    <!-- ================================= -->
    <!-- CREATE ANOTHER USER -->
    <!-- ================================= -->

    <p>

        <a href="/users/new">

            Create Another User

        </a>

    </p>


    <!-- ================================= -->
    <!-- HOME -->
    <!-- ================================= -->

    <p>

        <a href="/">

            Go Home

        </a>

    </p>


</body>

</html>